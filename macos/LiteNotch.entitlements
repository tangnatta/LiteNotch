<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets macOS ask the user whether LiteNotch may control the terminal,
         which is how a click on a session raises that session's window
         (TerminalWindow.swift). Nothing else is relaxed. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
